  "designCauses": [
    {
      "problem": "光源朦胧、缺少明确投影框",
      "implementation": "实体矩形玻璃口、四角光束、近角两路闭合的四边光学框。"
    },
    {
      "problem": "信息突然出现",
      "implementation": "标题与内容同一真实DOM投影平面；确定性遮罩先显身份再显主体，移除相机文字gate。"
    },
    {
      "problem": "镜头割裂",
      "implementation": "固定入口空间基准、同一已呈现相机状态与有限惯性接续；一次连续接近已形成画面的路径。"
    }
  ],
